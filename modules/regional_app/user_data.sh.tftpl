#!/bin/bash
set -euxo pipefail

# Install Python
dnf install -y python3 python3-pip

# Create application directory
mkdir -p /opt/storage-app

# Create Python virtual environment
python3 -m venv /opt/storage-app/venv

# Install dependencies
/opt/storage-app/venv/bin/pip install --upgrade pip
/opt/storage-app/venv/bin/pip install flask boto3 gunicorn

# Create Flask application
cat > /opt/storage-app/app.py <<'PYTHON'
import boto3
from flask import Flask, request, redirect, url_for, render_template_string, Response
from werkzeug.utils import secure_filename
from botocore.exceptions import BotoCoreError, ClientError

app = Flask(__name__)

PRIMARY_BUCKET = "${bucket_name}"
SECONDARY_BUCKET = "${secondary_bucket_name}"
PRIMARY_REGION = "${region_name}"
SECONDARY_REGION = "${secondary_region_name}"

app.config["MAX_CONTENT_LENGTH"] = 10 * 1024 * 1024

HTML = """
<!DOCTYPE html>
<html>
<head>
    <title>Self-Healing Cloud Storage</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f3f6fb;
            margin: 0;
            padding: 40px;
        }
        .container {
            max-width: 850px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px #0001;
        }
        h1 { color: #183b65; }
        .status { color: green; font-weight: bold; }
        button {
            background: #1769aa;
            color: white;
            border: 0;
            padding: 10px 18px;
            cursor: pointer;
            border-radius: 5px;
        }
        li { margin: 12px 0; }
        a { color: #1769aa; }
    </style>
</head>
<body>
<div class="container">
    <h1>Self-Healing Cloud Storage</h1>
    <p class="status">Application is running</p>
    <p><b>Region:</b> {{ region }}</p>
    <p><b>Active storage bucket:</b> {{ bucket }}</p>

    <h2>Upload a file</h2>
    <form action="/upload" method="POST" enctype="multipart/form-data">
        <input type="file" name="file" required>
        <button type="submit">Upload</button>
    </form>

    <h2>Stored files</h2>
    {% if files %}
        <ul>
        {% for item in files %}
            <li>
                {{ item }}
                <a href="/download/{{ item }}">Download</a>
            </li>
        {% endfor %}
        </ul>
    {% else %}
        <p>No files found or storage is temporarily unavailable.</p>
    {% endif %}

    {% if message %}
        <p><b>{{ message }}</b></p>
    {% endif %}
</div>
</body>
</html>
"""

def s3_client(region):
    return boto3.client("s3", region_name=region)

def bucket_locations():
    return [
        (PRIMARY_BUCKET, PRIMARY_REGION),
        (SECONDARY_BUCKET, SECONDARY_REGION)
    ]

def list_files():
    results = []

    for bucket, region in bucket_locations():
        try:
            response = s3_client(region).list_objects_v2(
                Bucket=bucket
            )

            for obj in response.get("Contents", []):
                results.append(obj["Key"])

        except (ClientError, BotoCoreError):
            continue

    return sorted(set(results))

@app.route("/health")
def health():
    return {
        "status": "healthy",
        "region": PRIMARY_REGION
    }, 200

@app.route("/")
def home():
    return render_template_string(
        HTML,
        region=PRIMARY_REGION,
        bucket=PRIMARY_BUCKET,
        files=list_files(),
        message=request.args.get("message", "")
    )

@app.route("/upload", methods=["POST"])
def upload():
    uploaded_file = request.files.get("file")

    if not uploaded_file or not uploaded_file.filename:
        return redirect(
            url_for("home", message="Please select a file")
        )

    filename = secure_filename(uploaded_file.filename)

    try:
        content = uploaded_file.read()

        try:
            s3_client(PRIMARY_REGION).put_object(
                Bucket=PRIMARY_BUCKET,
                Key=filename,
                Body=content
            )
            message = "File uploaded to the primary regional bucket."

        except (ClientError, BotoCoreError):
            s3_client(SECONDARY_REGION).put_object(
                Bucket=SECONDARY_BUCKET,
                Key=filename,
                Body=content
            )
            message = "Primary storage unavailable. File uploaded to secondary storage."

        return redirect(
            url_for("home", message=message)
        )

    except Exception:
        return redirect(
            url_for("home", message="Upload failed. Check application logs.")
        )

@app.route("/download/<path:filename>")
def download(filename):
    for bucket, region in bucket_locations():
        try:
            response = s3_client(region).get_object(
                Bucket=bucket,
                Key=filename
            )

            return Response(
                response["Body"].read(),
                mimetype="application/octet-stream",
                headers={
                    "Content-Disposition":
                        'attachment; filename="' +
                        secure_filename(filename) + '"'
                }
            )

        except (ClientError, BotoCoreError):
            continue

    return "File not found in either storage region", 404

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
PYTHON

# Create systemd service
cat > /etc/systemd/system/storage-app.service <<'SERVICE'
[Unit]
Description=Self Healing Storage Flask Application
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/storage-app
ExecStart=/opt/storage-app/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

# Enable and start application
systemctl daemon-reload
systemctl enable storage-app
systemctl restart storage-app


